+# --------------------------------------------------------------------------- elastic warp
+
+_ELASTIC_GAUSS = None
+
+
+def elastic_seed(key):
+    """A stable 31-bit seed from a filename, so a record always gets the same deformation.
+
+    ELASTIC_SALT re-draws every field for a realization-sensitivity check. Unset or "0"
+    reproduces the reported runs byte for byte, so the salt cannot silently perturb them.
+    """
+    import hashlib, os
+    salt = os.environ.get("ELASTIC_SALT", "0")
+    k = str(key) if salt in ("", "0") else f"{salt}:{key}"
+    return int(hashlib.blake2b(k.encode(), digest_size=8).hexdigest(), 16) % (2 ** 31)
