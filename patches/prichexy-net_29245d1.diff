+def elastic_warp(images, mu, keys):
+    """A non-learned deformation of the same form as PriCheXy-Net's warp.
+
+    PriCheXy-Net computes ``grid = identity - mu * G(x)``, smooths the grid with a 9x9
+    Gaussian (sigma=2) and resamples with border padding. This replaces the *learned*
+    field ``G(x)`` with a fixed random field and changes nothing else, so the comparison
+    isolates the learning rather than the deformation.
+
+    The field is drawn from a generator seeded by the record's filename, so a given record
+    always receives the same deformation. That matters: a released dataset is produced
+    once, and PriCheXy-Net's own warp is likewise deterministic given the image. Re-drawing
+    the field per access would hand the attacker an averaging-out opportunity that no real
+    release offers.
+
+    Smoothing the grid rather than the field reproduces the source implementation exactly,
+    border artefact included, so both arms inherit the same edge behaviour.
+
+    :param images: (N, 1, H, W) tensor in [0, 1] on the same device as the output
+    :param mu: float, deformation degree, the same knob the source work sweeps
+    :param keys: sequence of N filenames, one per image
+    """
+    global _ELASTIC_GAUSS
+    import torch as _t
+    import torch.nn.functional as _F
+    from utils.GaussianSmoothing import GaussianSmoothing
+
+    n, _, h, w = images.shape
+    if len(keys) != n:
+        raise ValueError(f"elastic_warp: {len(keys)} keys for {n} images")
+
+    if _ELASTIC_GAUSS is None or _ELASTIC_GAUSS[1] != images.device:
+        _ELASTIC_GAUSS = (GaussianSmoothing(channels=2, kernel_size=9, sigma=2).to(images.device),
+                          images.device)
+    gauss = _ELASTIC_GAUSS[0]
+
+    d = _t.linspace(-1, 1, h)
+    mesh_x, mesh_y = _t.meshgrid((d, d), indexing='ij')
+    identity = _t.stack((mesh_y, mesh_x), 2).unsqueeze(0).permute(0, 3, 1, 2).to(images.device)
+
+    fields = []
+    for k in keys:
+        g = _t.Generator().manual_seed(elastic_seed(k))
+        fields.append(_t.randn(2, h, w, generator=g))
+    field = _t.stack(fields).to(images.device)
+
+    grid = identity - mu * field
+    grid = gauss(grid).permute(0, 2, 3, 1)
+    return _F.grid_sample(images, grid, padding_mode='border', align_corners=True)
+
